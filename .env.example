PORT=3000

# Optional. Where the SQLite database file and uploaded product images are
# stored. Leave both unset for local development — they default to
# "data/ego.db" and "public/images/products/" respectively.
#
# On a host with a persistent disk (e.g. Render), point these at a path on
# that disk instead, so the database and uploaded images survive redeploys.
# Example, with a Render disk mounted at /var/data:
#   DATA_DIR=/var/data
#   UPLOADS_DIR=/var/data/uploads/products
DATA_DIR=
UPLOADS_DIR=

# Get these from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=replace-with-your-stripe-test-secret-key
STRIPE_PUBLISHABLE_KEY=replace-with-your-stripe-test-publishable-key

# Get this after creating a webhook endpoint in the Stripe dashboard
# pointing to https://your-domain.com/webhook
STRIPE_WEBHOOK_SECRET=replace-with-your-stripe-webhook-signing-secret

# Where Stripe should send customers after checkout
CLIENT_URL=http://localhost:3000

# Random long string used to sign login sessions (JWTs), for both admin and
# customer accounts.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Optional: sends an order confirmation email when a payment completes.
# Works with any SMTP provider (Gmail app password, SendGrid, Mailgun, Resend, etc).
# Leave SMTP_HOST unset to skip sending emails entirely.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=orders@wearego.com
